classDiagram
    direction LR
    %% Proposed design, not source-verified. Native type names are conceptual.
    %% Interfaces declare behavior; concrete backend classes hold implementation state.
    %% Queue submission and synchronization
    %% External references mirror the public APIs in their owning RHI files.
    class IQueue {
        <<interface>>
        +submit(SubmitDesc) Result~void~
        +present(PresentDesc) Result~void~
    }
    class MetalQueue {
        -QueueType m_queue_type
        -CommandBufferList m_pending_submissions
        -MTLCommandQueue m_queue
        +submit(SubmitDesc) Result~void~
        +present(PresentDesc) Result~void~
    }
    class VulkanQueue {
        -QueueType m_queue_type
        -InFlightList m_in_flight
        -VulkanSemaphoreRef m_timeline
        -PresentWaitMap m_presented
        -VkQueue m_queue
        +submit(SubmitDesc) Result~void~
        +present(PresentDesc) Result~void~
    }
    class GLQueue {
        -QueueType m_queue_type
        -CommandBufferList m_pending_submissions
        -GLContext m_context
        +submit(SubmitDesc) Result~void~
        +present(PresentDesc) Result~void~
    }
    class IFence {
        <<interface>>
        +wait(Timeout) Result~void~
        +isSignaled() bool
        +reset() Result~void~
    }
    class MetalFence {
        -FenceDesc m_desc
        -uint64 m_submission_value
        -MetalCompletionState m_completion
        +wait(Timeout) Result~void~
        +isSignaled() bool
        +reset() Result~void~
    }
    class VulkanFence {
        -FenceDesc m_desc
        -uint64 m_submission_value
        -VkFence m_fence
        +wait(Timeout) Result~void~
        +isSignaled() bool
        +reset() Result~void~
    }
    class GLFence {
        -FenceDesc m_desc
        -uint64 m_submission_value
        -GLsync m_sync
        +wait(Timeout) Result~void~
        +isSignaled() bool
        +reset() Result~void~
    }
    class ISemaphore {
        <<interface>>
        +getKind() SemaphoreKind
        +getValue() uint64
        +signal(uint64) Result~void~
    }
    class MetalSemaphore {
        -SemaphoreKind m_kind
        -uint64 m_value
        -MetalEventState m_event_state
        +getKind() SemaphoreKind
        +getValue() uint64
        +signal(uint64) Result~void~
    }
    class VulkanSemaphore {
        -SemaphoreKind m_kind
        -VkSemaphore m_semaphore
        +getKind() SemaphoreKind
        +getValue() uint64
        +signal(uint64) Result~void~
    }
    class GLSemaphore {
        -SemaphoreKind m_kind
        -uint64 m_value
        -GLSemaphoreState m_sync_state
        +getKind() SemaphoreKind
        +getValue() uint64
        +signal(uint64) Result~void~
    }
    class ICommandBuffer {
        <<external>>
        +begin() Result~void~
        +barrier(BarrierBatch) void
        +beginRender(RenderBeginDesc) RenderEncoderRef
        +beginCompute() ComputeEncoderRef
        +beginCopy() CopyEncoderRef
        +end() Result~void~
    }
    class ISwapchain {
        <<external>>
        +acquire(AcquireDesc) AcquireResult
        +resize(Extent) Result~void~
    }
    IQueue <|.. MetalQueue
    IQueue <|.. VulkanQueue
    IQueue <|.. GLQueue
    IFence <|.. MetalFence
    IFence <|.. VulkanFence
    IFence <|.. GLFence
    ISemaphore <|.. MetalSemaphore
    ISemaphore <|.. VulkanSemaphore
    ISemaphore <|.. GLSemaphore
    IQueue ..> ICommandBuffer : submits and retains
    IQueue ..> IFence : signals CPU completion
    IQueue ..> ISemaphore : GPU waits and signals
    IQueue ..> ISwapchain : presents
