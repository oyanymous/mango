classDiagram
    direction LR
    %% Proposed design, not source-verified. Native type names are conceptual.
    %% Interfaces declare behavior; concrete backend classes hold implementation state.
    %% Shaders, pipelines and resource bindings
    %% External references mirror the public APIs in their owning RHI files.
    class IShader {
        <<interface>>
        +getReflection() ShaderReflection
    }
    class MetalShader {
        -ShaderReflection m_reflection
        -MTLFunction m_function
        +getReflection() ShaderReflection
    }
    class VulkanShader {
        -ShaderReflection m_reflection
        -VkShaderModule m_shader_module
        +getReflection() ShaderReflection
    }
    class GLShader {
        -ShaderReflection m_reflection
        -GLuint m_shader
        +getReflection() ShaderReflection
    }
    class IPipelineLayout {
        <<interface>>
        +getDesc() PipelineLayoutDesc
    }
    class MetalPipelineLayout {
        -PipelineLayoutDesc m_desc
        -BindGroupLayoutList m_bind_group_layouts
        -MetalBindingMap m_binding_map
        +getDesc() PipelineLayoutDesc
    }
    class VulkanPipelineLayout {
        -PipelineLayoutDesc m_desc
        -BindGroupLayoutList m_bind_group_layouts
        -VkPipelineLayout m_pipeline_layout
        +getDesc() PipelineLayoutDesc
    }
    class GLPipelineLayout {
        -PipelineLayoutDesc m_desc
        -BindGroupLayoutList m_bind_group_layouts
        -GLBindingMap m_binding_map
        +getDesc() PipelineLayoutDesc
    }
    class IPipeline {
        <<interface>>
        +getKind() PipelineKind
    }
    class MetalPipeline {
        -PipelineKind m_kind
        -PipelineLayoutRef m_layout
        -ShaderList m_shaders
        -MetalPipelineStateBundle m_pipeline_state
        +getKind() PipelineKind
    }
    class VulkanPipeline {
        -PipelineKind m_kind
        -PipelineLayoutRef m_layout
        -ShaderList m_shaders
        -VkPipeline m_pipeline
        +getKind() PipelineKind
    }
    class GLPipeline {
        -PipelineKind m_kind
        -PipelineLayoutRef m_layout
        -ShaderList m_shaders
        -GLuint m_program
        +getKind() PipelineKind
    }
    class IBindGroupLayout {
        <<interface>>
        +getDesc() BindGroupLayoutDesc
    }
    class MetalBindGroupLayout {
        -BindGroupLayoutDesc m_desc
        -MetalBindingMap m_binding_map
        +getDesc() BindGroupLayoutDesc
    }
    class VulkanBindGroupLayout {
        -BindGroupLayoutDesc m_desc
        -VkDescriptorSetLayout m_descriptor_set_layout
        +getDesc() BindGroupLayoutDesc
    }
    class GLBindGroupLayout {
        -BindGroupLayoutDesc m_desc
        -GLBindingMap m_binding_map
        +getDesc() BindGroupLayoutDesc
    }
    class IBindGroup {
        <<interface>>
        +getDesc() BindGroupDesc
    }
    class MetalBindGroup {
        -BindGroupDesc m_desc
        -BindGroupLayoutRef m_layout
        -ResourceRefList m_resources
        -MetalResourceBindings m_bindings
        +getDesc() BindGroupDesc
    }
    class VulkanBindGroup {
        -BindGroupDesc m_desc
        -BindGroupLayoutRef m_layout
        -ResourceRefList m_resources
        -VkDescriptorSet m_descriptor_set
        +getDesc() BindGroupDesc
    }
    class GLBindGroup {
        -BindGroupDesc m_desc
        -BindGroupLayoutRef m_layout
        -ResourceRefList m_resources
        -GLResourceBindings m_bindings
        +getDesc() BindGroupDesc
    }
    class IRenderPass {
        <<external>>
        +getDesc() RenderPassDesc
    }
    class IBuffer {
        <<external>>
        +getDesc() BufferDesc
        +map(MapDesc) MapResult
        +unmap() void
    }
    class ITextureView {
        <<external>>
        +getTexture() TextureRef
    }
    class ISampler {
        <<external>>
        +getDesc() SamplerDesc
    }
    IShader <|.. MetalShader
    IShader <|.. VulkanShader
    IShader <|.. GLShader
    IPipelineLayout <|.. MetalPipelineLayout
    IPipelineLayout <|.. VulkanPipelineLayout
    IPipelineLayout <|.. GLPipelineLayout
    IPipeline <|.. MetalPipeline
    IPipeline <|.. VulkanPipeline
    IPipeline <|.. GLPipeline
    IBindGroupLayout <|.. MetalBindGroupLayout
    IBindGroupLayout <|.. VulkanBindGroupLayout
    IBindGroupLayout <|.. GLBindGroupLayout
    IBindGroup <|.. MetalBindGroup
    IBindGroup <|.. VulkanBindGroup
    IBindGroup <|.. GLBindGroup
    IPipeline --> IPipelineLayout : retains
    IPipeline --> IShader : compiled from
    IPipeline ..> IRenderPass : compatibility signature
    IPipelineLayout --> IBindGroupLayout : retains
    IBindGroup --> IBindGroupLayout : retains
    IBindGroup --> IBuffer : retains
    IBindGroup --> ITextureView : retains
    IBindGroup --> ISampler : retains
