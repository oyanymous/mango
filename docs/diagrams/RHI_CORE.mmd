classDiagram
    direction LR
    %% Proposed design, not source-verified. Native type names are conceptual.
    %% Interfaces declare behavior; concrete backend classes hold implementation state.
    %% Factories, instances, adapters and the complete device API
    %% External references mirror the public APIs in their owning RHI files.
    class RHIFactory {
        +createInstance(Backend, InstanceDesc) Result~InstanceRef~
        +availableBackends() BackendList
    }
    class IDeviceFactory {
        <<interface>>
        +createInstance(InstanceDesc) Result~InstanceRef~
    }
    class MetalDeviceFactory {
        +isAvailable()$ bool
        +createInstance(InstanceDesc) Result~InstanceRef~
    }
    class VulkanDeviceFactory {
        -Backend m_backend = Vulkan
        +createInstance(InstanceDesc) Result~InstanceRef~
    }
    class GLDeviceFactory {
        -Backend m_backend = GL
        +createInstance(InstanceDesc) Result~InstanceRef~
    }
    class IInstance {
        <<interface>>
        +enumerateAdapters() AdapterList
        +createSurface(SurfaceDesc) Result~SurfaceRef~
    }
    class MetalInstance {
        -InstanceDesc m_desc
        -AdapterList m_adapters
        -MetalDebugReporter m_reporter
        +enumerateAdapters() AdapterList
        +createSurface(SurfaceDesc) Result~SurfaceRef~
    }
    class VulkanInstance {
        -InstanceDesc m_desc
        -AdapterList m_adapters
        -VkInstance m_instance
        +enumerateAdapters() AdapterList
        +createSurface(SurfaceDesc) Result~SurfaceRef~
    }
    class GLInstance {
        -InstanceDesc m_desc
        -AdapterList m_adapters
        -GLContextFactory m_context_factory
        +enumerateAdapters() AdapterList
        +createSurface(SurfaceDesc) Result~SurfaceRef~
    }
    class IAdapter {
        <<interface>>
        +getCapabilities() Capabilities
        +createDevice(DeviceDesc) Result~DeviceRef~
    }
    class MetalAdapter {
        -Capabilities m_capabilities
        -MTLDevice m_device
        -MetalDebugReporter m_reporter
        +getCapabilities() Capabilities
        +createDevice(DeviceDesc) Result~DeviceRef~
    }
    class VulkanAdapter {
        -Capabilities m_capabilities
        -VkPhysicalDevice m_physical_device
        +getCapabilities() Capabilities
        +createDevice(DeviceDesc) Result~DeviceRef~
    }
    class GLAdapter {
        -Capabilities m_capabilities
        -GLAdapterInfo m_adapter_info
        +getCapabilities() Capabilities
        +createDevice(DeviceDesc) Result~DeviceRef~
    }
    class IDevice {
        <<interface>>
        +getQueue(QueueType) QueueRef
        +createBuffer(BufferDesc) Result~BufferRef~
        +createTexture(TextureDesc) Result~TextureRef~
        +createTextureView(TextureViewDesc) Result~TextureViewRef~
        +createSampler(SamplerDesc) Result~SamplerRef~
        +createShader(ShaderDesc) Result~ShaderRef~
        +createPipelineLayout(PipelineLayoutDesc) Result~PipelineLayoutRef~
        +createGraphicsPipeline(GraphicsPipelineDesc) Result~PipelineRef~
        +createComputePipeline(ComputePipelineDesc) Result~PipelineRef~
        +createRenderPass(RenderPassDesc) Result~RenderPassRef~
        +createRenderTarget(RenderTargetDesc) Result~RenderTargetRef~
        +createBindGroupLayout(BindGroupLayoutDesc) Result~BindGroupLayoutRef~
        +createBindGroup(BindGroupDesc) Result~BindGroupRef~
        +createCommandBuffer(CommandBufferDesc) Result~CommandBufferRef~
        +createSwapchain(SwapchainDesc) Result~SwapchainRef~
        +createFence(FenceDesc) Result~FenceRef~
        +createSemaphore(SemaphoreDesc) Result~SemaphoreRef~
    }
