    class ISurface {
        <<external>>
        +getDesc() SurfaceDesc
    }
    class IQueue {
        <<external>>
        +submit(SubmitDesc) Result~void~
        +present(PresentDesc) Result~void~
    }
    class ISwapchain {
        <<external>>
        +acquire(AcquireDesc) AcquireResult
        +resize(Extent) Result~void~
    }
    class IBuffer {
        <<external>>
        +getDesc() BufferDesc
        +map(MapDesc) MapResult
        +unmap() void
    }
    class ITexture {
        <<external>>
        +getDesc() TextureDesc
    }
    class ITextureView {
        <<external>>
        +getTexture() TextureRef
    }
    class ISampler {
        <<external>>
        +getDesc() SamplerDesc
    }
    class IShader {
        <<external>>
        +getReflection() ShaderReflection
    }
    class IPipelineLayout {
        <<external>>
        +getDesc() PipelineLayoutDesc
    }
    class IPipeline {
        <<external>>
        +getKind() PipelineKind
    }
    class IRenderPass {
        <<external>>
        +getDesc() RenderPassDesc
    }
    class IRenderTarget {
        <<external>>
        +getDesc() RenderTargetDesc
    }
    class IBindGroupLayout {
        <<external>>
        +getDesc() BindGroupLayoutDesc
    }
    class IBindGroup {
        <<external>>
        +getDesc() BindGroupDesc
    }
    class ICommandBuffer {
        <<external>>
        +begin() Result~void~
        +barrier(BarrierBatch) void
        +beginRender(RenderBeginDesc) RenderEncoderRef
        +beginCompute() ComputeEncoderRef
        +beginCopy() CopyEncoderRef
        +end() Result~void~
    }
    class IFence {
        <<external>>
        +wait(Timeout) Result~void~
        +isSignaled() bool
        +reset() Result~void~
    }
    class ISemaphore {
        <<external>>
        +getKind() SemaphoreKind
        +getValue() uint64
        +signal(uint64) Result~void~
    }
