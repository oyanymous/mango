    %% Proposed design, not source-verified. Native type names are conceptual.
    %% Interfaces declare behavior; concrete backend classes hold implementation state.
    %% Command recording and scoped encoders
    %% External references mirror the public APIs in their owning RHI files.
    class ICommandBuffer {
        <<interface>>
        +begin() Result~void~
        +barrier(BarrierBatch) void
        +beginRender(RenderBeginDesc) RenderEncoderRef
        +beginCompute() ComputeEncoderRef
        +beginCopy() CopyEncoderRef
        +end() Result~void~
    }
    class MetalCommandBuffer {
        -CommandBufferDesc m_desc
