{
    "version": 8,
    "configurePresets": [
        {
            "name": "macos",
            "displayName": "Clang 21.0.0 arm64-apple-darwin25.6.0",
            "description": "Using compilers: C = /usr/bin/clang, CXX = /usr/bin/clang++",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/${presetName}",
                "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "windows",
            "displayName": "MSVC x64 (Ninja)",
            "description": "MSVC (cl) + Ninja. Run from a Developer PowerShell / x64 Native Tools prompt, or from an IDE that sets up the MSVC environment (CLion's Visual Studio toolchain, Visual Studio).",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/${presetName}",
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl",
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "macos",
            "description": "",
            "displayName": "",
            "configurePreset": "macos"
        },
        {
            "name": "windows",
            "configurePreset": "windows"
        }
    ],
    "testPresets": [
        {
            "name": "macos",
            "configurePreset": "macos",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows",
            "configurePreset": "windows",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
